                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/pages/{page_id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Получить анкету(страницу) одного пользователя",
