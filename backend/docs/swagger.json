    "definitions": {
        "database.Error": {
            "description": "Ошибка",
            "type": "object",
            "properties": {
                "cause": {
                    "type": "string"
                },
                "status_code": {
                    "type": "integer"
                }
            }
        },
        "database.Namespace": {
            "description": "Неймспейс",
            "type": "object",
            "properties": {
                "admin": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "picture": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "database.User": {
            "description": "Основные данные профиля и связанные виджеты.",
            "type": "object",
            "properties": {
                "birth_date": {
                    "type": "string"
                },
                "gender": {
                    "type": "string"
                },
                "hide": {
                    "type": "boolean"
                },
                "interests": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
