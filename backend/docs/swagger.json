{
    "swagger": "2.0",
    "info": {
        "description": "Shumi API",
        "title": "Shumi API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/api/auth": {
            "post": {
                "security": [
                    {
                        "TmaAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Получить токен авторизации",
                "responses": {
                    "200": {
                        "description": "Токен выдан",
                        "schema": {
                            "$ref": "#/definitions/handlers.JWTTokens"
                        }
                    },
                    "401": {
                        "description": "Не валидный токен авторизации",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    },
                    "403": {
                        "description": "Пользователь не записан в базу данных",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/autocomplete": {
            "get": {
                "description": "Возвращает список интересов, семантически похожих на запрос 'q'.",
                "produces": [
                    "application/json"
                ],
                "summary": "Предложенные интересы",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Строка для поиска и автодополнения интересов",
                        "name": "q",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешное получение списка интересов",
                        "schema": {
                            "$ref": "#/definitions/handlers.AutocompleteResponse"
                        }
                    },
                    "401": {
                        "description": "Ошибка авторизации",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/games": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Игры пользователя из его steam профиля для виджета",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Ссылка на профиль",
                        "name": "link",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Игры из steam профиля пользователя",
                        "schema": {
                            "$ref": "#/definitions/handlers.Games"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/me": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Профиль пользователя",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/database.User"
                        }
                    },
                    "401": {
                        "description": "Пользователь не авторизован",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            },
            "patch": {
                "consumes": [
                    "application/json"
                ],
                "summary": "Обновить информацию профиля пользователя",
                "parameters": [
                    {
                        "description": "Имя пользователя",
                        "name": "miniapp_name",
                        "in": "body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Локация пользователя",
                        "name": "location",
                        "in": "body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Пол пользователя",
                        "name": "gender",
                        "in": "body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Дата рождения пользователя",
                        "name": "birth_date",
                        "in": "body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Информация о пользователе",
                        "name": "info",
                        "in": "body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Интересы о пользователе",
                        "name": "interests",
                        "in": "body",
                        "schema": {
                            "type": "array"
                        }
                    },
                    {
                        "description": "Личностный тест (5 слайдеров)",
                        "name": "personality_test",
                        "in": "body",
                        "schema": {
                            "type": "array"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Пользователь успешно обновлен"
                    },
                    "401": {
                        "description": "Пользователь не авторизован",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/me/namespaces": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Неймспейсы пользователя",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.UserNamespaces"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/me/photo": {
            "patch": {
                "consumes": [
                    "application/json"
                ],
                "summary": "Обновить фото профиля пользователя",
                "parameters": [
                    {
                        "description": "Фото пользователя",
                        "name": "user_photo",
                        "in": "body",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Пользователь успешно обновлен"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/me/widgets": {
            "post": {
                "consumes": [
                    "multipart/form-data"
                ],
                "summary": "Создать виджет",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Данные виджета",
                        "name": "data",
                        "in": "formData"
                    },
                    {
                        "type": "array",
                        "description": "Файлы виджета",
                        "name": "files",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Виджет успешно создан"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            },
            "delete": {
                "summary": "Удалить виджет",
                "parameters": [
                    {
                        "type": "string",
                        "description": "id виджета",
                        "name": "widget_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Виджет удален"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            },
            "patch": {
                "consumes": [
                    "multipart/form-data"
                ],
                "summary": "Обновить виджет",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Данные виджета (JSON)",
                        "name": "data",
                        "in": "formData"
                    },
                    {
                        "type": "array",
                        "description": "Файлы виджета",
                        "name": "files",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Виджет успешно обновлен"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/me/widgets/order": {
            "patch": {
                "consumes": [
                    "multipart/form-data"
                ],
                "summary": "Обновить очередь виджета",
                "parameters": [
                    {
                        "type": "string",
                        "description": "id виджета",
                        "name": "widget_id",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Изменение позиции виджета виджета",
                        "name": "order",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Очередь успешно обновлена"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/me/widgets/photo": {
            "delete": {
                "summary": "Удалить фото виджета",
                "parameters": [
                    {
                        "type": "string",
                        "description": "id виджета",
                        "name": "widget_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Позиция фото в списке",
                        "name": "index",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Фото виджета удалено"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/namespace": {
            "post": {
                "consumes": [
                    "multipart/form-data"
                ],
                "summary": "Создать неймспейс",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Название неймспейса",
                        "name": "title",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Картинка неймспейса",
                        "name": "photo",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Описание неймспейса",
                        "name": "description",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Неймспейс успешно создан"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            },
            "delete": {
                "summary": "Удалить неймспейс",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Название неймспейса",
                        "name": "id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Неймспейс успешно удален"
                    },
                    "403": {
                        "description": "Этот пользователь не админ неймспейса",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            },
            "patch": {
                "consumes": [
                    "multipart/form-data"
                ],
                "summary": "Обновить информацию о неймспейсе",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Название неймспейса",
                        "name": "title",
                        "in": "formData"
                    },
                    {
                        "type": "file",
                        "description": "Картинка неймспейса",
                        "name": "photo",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Описание неймспейса",
                        "name": "description",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Неймспейс успешно обновлен"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/namespace/{namespace_id}": {
            "post": {
                "consumes": [
                    "multipart/form-data"
                ],
                "summary": "Зайти в неймспейс",
                "parameters": [
                    {
                        "type": "string",
                        "description": "id неймспейса",
                        "name": "namespace_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "инвайт код для входа в неймспейс",
                        "name": "invite_code",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешный вход"
                    },
                    "403": {
                        "description": "Неверный код входа",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            },
            "delete": {
                "summary": "Выйти из неймспейса",
                "parameters": [
                    {
                        "type": "string",
                        "description": "id неймспейса",
                        "name": "namespace",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешный вход"
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/namespace/{namespace_id}/feed": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Получить ленту из анкет пользователей неймспейса",
                "parameters": [
                    {
                        "type": "string",
                        "description": "id неймспейса",
                        "name": "namespace_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handlers.PageData"
                            }
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/database.Error"
                        }
                    }
                }
            }
        },
        "/api/namespace/{namespace_id}/pages": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Получить пользователей неймспейса",
                "parameters": [
                    {
                        "type": "string",
                        "description": "id неймспейса",
                        "name": "namespace_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
